# Set these in Vercel -> Project -> Settings -> Environment Variables.
# Never commit a real .env or expose provider keys in public browser code.

# Supabase: Project Settings -> API Keys
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=

# Flash (Gemini 2.5 Flash-Lite; free-tier model) and Google Search grounding
GOOGLE_API_KEY=

# Cognition (NVIDIA Nemotron 3 Ultra free via OpenRouter)
# The model ID is hardcoded in api/_llm.js; only the secret key belongs here.
OPENROUTER_API_KEY=

# Optional: only these email addresses may use registered accounts.
# Empty = any signed-in account may chat.
ALLOWED_EMAILS=
